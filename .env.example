# NEOTRADE - environment variable reference. Names only: copy to .env (which is
# git-ignored) and fill in real values on the SERVER. Never commit real values and
# never put any of the SERVER-ONLY values into frontend code or the Android app.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public hostname of the deployed app, without protocol (added to the CORS allow-list)
APP_DOMAIN=
# Secret path of the admin panel (defaults to a built-in path if unset - set your own)
ADMIN_URL_PATH=

# ── Database (SERVER-ONLY) ───────────────────────────────────────────────
# Neon: use the direct (non "-pooler") connection string with ?sslmode=require
DATABASE_URL=

# ── Auth / sessions (SERVER-ONLY) ────────────────────────────────────────
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASS=

# ── Email: registration OTP + password reset (SERVER-ONLY) ──────────────
# Option 00 (no card needed): Google Apps Script relay — see
#   scripts/gmail-relay.gs for setup. Sends from the Gmail account that owns
#   the script (~100 recipients/day on a free Gmail account).
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# Option 0 (most reliable with a @gmail.com sender): Gmail API over HTTPS.
#   Mail is sent by Gmail itself from netradeofficiall@gmail.com. Needs a
#   Google Cloud OAuth client with the gmail.send scope and a refresh token.
#   When all three are set this is used instead of Brevo/SMTP.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Option A (recommended on Render): Brevo HTTP API over port 443.
#   Brevo -> SMTP & API -> API Keys (starts with "xkeysib-"). Verify
#   netradeofficiall@gmail.com under Brevo -> Senders first.
BREVO_API_KEY=
# Sender users see. Defaults to this value if unset.
SMTP_FROM=NEOTRADE <netradeofficiall@gmail.com>
# Option B: plain SMTP (used only when BREVO_API_KEY is empty). For Gmail set
# SMTP_USER=netradeofficiall@gmail.com and SMTP_PASS=<16-char Google App
# Password>; host/port then default to smtp.gmail.com:465. Render's FREE plan
# blocks ports 25/465/587, so use Option A there.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── TRC20 deposit address ────────────────────────────────────────────────
# The single platform-wide USDT (TRC20) deposit address shown to every account.
# No per-user wallets are generated. Read only from the server environment —
# it cannot be changed through any API. Defaults to this value if unset.
TRC20_RECEIVING_ADDRESS=TFk6S5zkJKuFAb1QjbHDVr2Lv95oSSCYLN
# Optional TronGrid API key (read-only, not a wallet key) used to verify deposit
# TXIDs on-chain. Without it TronGrid rate-limits verification requests.
TRON_API_KEY=

UPLOADS_DIR=

# ── Android build (public values; only read by capacitor.config.js at build time) ──
# HTTPS URL of the deployed NEOTRADE server that the APK loads. Required.
NETRONTRADE_APP_URL=https://netrontrade.onrender.com
# Release signing (optional; keep the keystore file itself out of git)
NETRONTRADE_KEYSTORE_PATH=
NETRONTRADE_KEYSTORE_PASSWORD=
NETRONTRADE_KEY_ALIAS=
NETRONTRADE_KEY_PASSWORD=
