{
  "name": "netrontrade-platform",
  "version": "1.0.0",
  "description": "NEOTRADE Premium Digital Asset Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma && node backend/scripts/archive-legacy-wallets.js && node node_modules/prisma/build/index.js db push --schema=backend/prisma/schema.prisma --accept-data-loss",
    "android:assets": "node scripts/generate-brand-assets.js && capacitor-assets generate --android",
    "android:build-web": "node scripts/build-web.js",
    "android:sync": "npm run android:build-web && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew.bat assembleRelease",
    "postinstall": "node node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.1",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.1",
    "speakeasy": "^2.0.0",
    "tronweb": "^6.3.0",
    "ws": "^8.20.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "nodemon": "^3.0.1",
    "playwright": "^1.62.1"
  }
}
